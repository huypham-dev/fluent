{
  "name": "textactions",
  "productName": "TextActions",
  "version": "0.0.1",
  "description": "Act on selected text in any app",
  "author": "TextActions",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "start": "npm run build && electron .",
    "dist:mac": "npm run build && electron-builder --mac dmg --arm64 --x64",
    "dist:win": "npm run build && electron-builder --win nsis --x64"
  },
  "build": {
    "appId": "local.textactions.app",
    "directories": {
      "output": "release"
    },
    "npmRebuild": false,
    "files": [
      "dist/**",
      "static/**"
    ],
    "asarUnpack": [
      "node_modules/uiohook-napi/**"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "identity": "-",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "extendInfo": {
        "LSUIElement": true
      }
    },
    "win": {
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    }
  },
  "dependencies": {
    "uiohook-napi": "1.5.5"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
